{
  "name": "MarkNote · 个人笔记本",
  "short_name": "MarkNote",
  "description": "Markdown 双模式笔记本：目录透明存储 / SQLite 数据库存储，左编辑右实时渲染",
  "lang": "zh-CN",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f8fafc",
  "theme_color": "#0f1115",
  "share_target": {
    "action": "./index.html?share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": { "text/markdown": [".md", ".markdown"], "text/plain": [".txt"] }
    }
  ],
  "launch_handler": { "client_mode": "navigate-new" },
  "protocol_handlers": [
    { "protocol": "web+marknote", "url": "./index.html?share&title=%s" }
  ],
  "shortcuts": [
    { "name": "速记一条", "short_name": "速记", "url": "./index.html?action=quick" },
    { "name": "今天的笔记", "short_name": "今天", "url": "./index.html?action=today" },
    { "name": "最近搜索", "short_name": "搜索", "url": "./index.html?action=search" }
  ],
  "icons": [
    { "src": "./marknote-notes-192.20261127-162432-628.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./marknote-notes-512.20261127-162432-628.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./marknote-notes-maskable-512.20261127-162432-628.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./marknote-notes.20261127-162432-628.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
